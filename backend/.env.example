# MySQL（账号密码与 07a02 §5 创建的业务账号一致）
# 密码含 @，必须 URL 编码为 %40，否则 @ 会被当成用户/主机分隔符
MYSQL_URL=mysql+pymysql://123:123@localhost:3306/test?charset=utf8mb4
# Milvus gRPC 服务地址（07a03，端口 19530）
MILVUS_URI=http://localhost:19530
# DashScope（阿里云百炼）API Key：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=sk-xx
# JWT 签名密钥：换一串足够长的随机字符串，不要提交 git
JWT_SECRET_KEY=xxx
# JWT 有效期（分钟），720 = 12 小时，覆盖一个工作班次
JWT_EXPIRE_MINUTES=720
# 上传文件保存目录（相对 backend/ 目录）
UPLOAD_DIR=uploads